# ================================================
# CONFIGURAÇÕES DO SERVIDOR
# ================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8001

# ================================================
# SEGURANÇA
# ================================================
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_min_32_chars
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=sua_chave_de_criptografia_32_chars
SESSION_SECRET=sua_chave_de_sessao_secreta

# ================================================
# BANCO DE DADOS
# ================================================
MONGODB_URI=mongodb://localhost:27017/sistema_financeiro
REDIS_URL=redis://localhost:6379

# ================================================
# OPEN FINANCE BRASIL - CREDENCIAIS
# ================================================
# Para obter credenciais, registre-se no portal do Banco Central:
# https://openfinancebrasil.atlassian.net/wiki/spaces/OF/overview

# Nubank
NUBANK_CLIENT_ID=seu_client_id_nubank
NUBANK_CLIENT_SECRET=seu_client_secret_nubank
NUBANK_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/nubank

# Itaú
ITAU_CLIENT_ID=seu_client_id_itau
ITAU_CLIENT_SECRET=seu_client_secret_itau
ITAU_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/itau

# Bradesco
BRADESCO_CLIENT_ID=seu_client_id_bradesco
BRADESCO_CLIENT_SECRET=seu_client_secret_bradesco
BRADESCO_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/bradesco

# Santander
SANTANDER_CLIENT_ID=seu_client_id_santander
SANTANDER_CLIENT_SECRET=seu_client_secret_santander
SANTANDER_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/santander

# Banco do Brasil
BB_CLIENT_ID=seu_client_id_bb
BB_CLIENT_SECRET=seu_client_secret_bb
BB_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/bb

# Caixa Econômica
CAIXA_CLIENT_ID=seu_client_id_caixa
CAIXA_CLIENT_SECRET=seu_client_secret_caixa
CAIXA_REDIRECT_URI=http://localhost:3000/api/openfinance/callback/caixa

# ================================================
# CERTIFICADOS DIGITAIS (Obrigatório para Open Finance)
# ================================================
# Certificado BRCAC (Transport) - Emitido por AC credenciada
CERT_PATH=./certs/certificate.pem
CERT_KEY_PATH=./certs/private-key.pem
CERT_CA_PATH=./certs/ca-bundle.pem

# ================================================
# LOGS E MONITORAMENTO
# ================================================
LOG_LEVEL=info
SENTRY_DSN=seu_sentry_dsn_aqui
